---

---

<section
	class="section-padding cta-section"
	id="contact"
>
	<div class="cta-bg-glow"></div>
	<div class="container text-center">
		<h2>Ready to <span class="text-gradient">Automate?</span></h2>
		<p class="cta-desc">
			Stop wasting time on manual processes. Let's build a system that
			works while you sleep. Book a free 15-minute discovery call.
		</p>
		<div class="btn-group">
			<button
				class="btn btn-primary cta-btn"
				id="scrollToContact"
			>
				Book Consultation
			</button>
		</div>
	</div>
</section>

<script>
	const ctaBtn = document.getElementById("scrollToContact");
	if (ctaBtn) {
		ctaBtn.addEventListener("click", () => {
			const contactSection = document.getElementById("contact-form");
			if (contactSection) {
				contactSection.scrollIntoView({
					behavior: "smooth",
					block: "start",
				});
			}
		});
	}
</script>

<style>
	.cta-section {
		padding: 10rem 0 12rem;
		background: transparent;
		position: relative;
		overflow: hidden;
		text-align: center;
	}

	.cta-bg-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 800px;
		height: 800px;
		background: radial-gradient(
			circle,
			rgba(0, 240, 255, 0.15) 0%,
			rgba(4, 7, 18, 0) 70%
		);
		pointer-events: none;
		z-index: 0;
	}

	.container {
		position: relative;
		z-index: 1;
	}

	h2 {
		font-size: clamp(3rem, 6vw, 4.5rem);
		margin-bottom: 2rem;
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.text-gradient {
		background: var(--gradient-tech);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.cta-desc {
		font-size: 1.25rem;
		color: var(--text-secondary);
		max-width: 650px;
		margin: 0 auto 4rem;
		line-height: 1.8;
	}

	.btn {
		padding: 1.2rem 3rem;
		border-radius: 8px;
		font-weight: 700;
		font-size: 1rem;
		transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
		display: inline-block;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		background: var(--accent-cyan);
		color: var(--bg-dark);
		border: none;
	}

	.btn:hover {
		transform: translateY(-5px) scale(1.02);
		box-shadow: 0 20px 40px var(--accent-cyan-glow);
		filter: brightness(1.1);
	}
</style>
