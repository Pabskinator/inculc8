<section
	class="problem-section snap-section"
	id="challenge"
>
	<div class="container problem-grid">
		<div class="problem-visual">
			<!-- Space reserved for the 3D model (left side in this act) -->
		</div>

		<div class="problem-content">
			<div class="badge-wrapper">
				<span class="badge">The Challenge</span>
			</div>

			<h2 class="section-title">
				Modern Businesses are <br />
				<span class="text-gradient italics">Fading Away.</span>
			</h2>

			<p class="lead">
				Fragmentation and manual inertia are the silent killers of
				scale. Without a unified digital logic, your growth is capped by
				the limits of human repetition.
			</p>

			<div class="stats-list">
				<div class="stat-card">
					<span
						class="stat-num"
						data-val="20"
						>0</span
					><span class="stat-suffix">h+</span>
					<p>Wasted on manual admin tasks weekly.</p>
				</div>
				<div class="stat-card">
					<span
						class="stat-num"
						data-val="60"
						>0</span
					><span class="stat-suffix">%</span>
					<p>Revenue leak via disconnected funnels.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.problem-section {
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: 0;
		position: relative;
	}

	.problem-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	@media (max-width: 992px) {
		.problem-grid {
			grid-template-columns: 1fr;
		}
		.problem-visual {
			display: none;
		}
	}

	.problem-content {
		position: relative;
		z-index: 2;
	}

	.italics {
		font-style: italic;
	}

	.section-title {
		margin-bottom: 2rem;
	}

	.lead {
		font-size: 1.25rem;
		color: var(--text-primary-muted);
		margin-bottom: 4rem;
		font-weight: 300;
		max-width: 600px;
	}

	.stats-list {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.stat-card {
		padding-left: 2rem;
		border-left: 1px solid var(--glass-border);
		transition: all 0.5s ease;
	}

	.stat-card:hover {
		border-left: 2px solid var(--accent-cyan);
		padding-left: 2.5rem;
	}

	.stat-num {
		font-family: var(--font-heading);
		font-size: 3.5rem;
		font-weight: 500;
		color: var(--text-primary);
	}

	.stat-suffix {
		font-family: var(--font-heading);
		font-size: 2rem;
		color: var(--accent-cyan);
	}

	.stat-card p {
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-secondary);
		margin-top: 0.5rem;
		font-weight: 600;
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	gsap.registerPlugin(ScrollTrigger);

	// Event-Driven Animation for Index 1 (Problem Section)
	window.addEventListener("sectionChange", ((e: CustomEvent) => {
		const { index, isActive } = e.detail;

		if (index === 1 && isActive) {
			// Animate stats numbers
			const stats = document.querySelectorAll(".stat-num");
			stats.forEach((stat) => {
				const target = parseInt(stat.getAttribute("data-val") || "0");
				gsap.to(stat, {
					innerText: target,
					duration: 2,
					snap: { innerText: 1 },
					ease: "power2.out",
					overwrite: true,
				});
			});
		} else {
			// Reset immediately when not active
			const stats = document.querySelectorAll(".stat-num");
			stats.forEach((stat) => {
				gsap.set(stat, { innerText: 0 });
			});
		}
	}) as EventListener);
</script>
