<section class="contact-section">
	<div class="container">
		<div class="contact-header">
			<div
				class="badge-wrapper"
				data-scroll
				data-scroll-speed="1.2"
			>
				<span class="badge">Inquiry</span>
			</div>

			<h2 class="section-title centered">
				Begin your <br />
				<span class="text-gradient italics">Evolution.</span>
			</h2>
			<p class="lead">
				We are selective with our partnerships. If you are ready to
				redefine your digital logic, let's commence the dialogue.
			</p>
		</div>

		<form
			class="contact-form"
			id="contactForm"
		>
			<input
				type="hidden"
				name="access_key"
				value="67d0a537-0c20-47ef-ba77-fdc3b41160f7"
			/>

			<div class="form-grid">
				<div class="form-group">
					<input
						type="text"
						name="name"
						required
						placeholder="Full Name"
					/>
				</div>
				<div class="form-group">
					<input
						type="email"
						name="email"
						required
						placeholder="Email Address"
					/>
				</div>
			</div>

			<div class="form-group">
				<textarea
					name="message"
					required
					rows="4"
					placeholder="How shall we redefine your business?"
				></textarea>
			</div>

			<button
				type="submit"
				class="btn-submit"
			>
				<span class="btn-text">Send Enquiry</span>
				<div class="btn-glow"></div>
			</button>

			<div class="form-messages">
				<div class="form-message success">
					✓ Enquiry sent. We will respond shortly.
				</div>
				<div class="form-message error">
					✗ Transmission failed. Please try again.
				</div>
			</div>
		</form>
	</div>
</section>

<style>
	.contact-section {
		min-height: 40vh; /* Was 60vh, reducing for better fit with footer */
		display: flex;
		align-items: center;
		padding: 3rem 0; /* Was var(--section-spacing) which is large */
		position: relative;
		text-align: center;
	}

	.contact-header {
		margin-bottom: 5rem;
	}

	.italics {
		font-style: italic;
	}

	.contact-form {
		max-width: 700px;
		margin: 0 auto;
		position: relative;
		z-index: 10;
	}

	.form-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.form-group {
		margin-bottom: 2rem;
	}

	input,
	textarea {
		width: 100%;
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--text-muted);
		padding: 1.5rem 0.5rem;
		color: var(--text-primary);
		font-family: var(--font-body);
		font-size: 1.1rem;
		transition:
			all 0.4s ease,
			border-bottom-color 0.4s ease;
		border-radius: 0;
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-bottom-color: var(--accent-cyan);
		padding-left: 1rem;
	}

	::placeholder {
		color: var(--text-muted);
		opacity: 0.8; /* Increased for readability */
		text-transform: uppercase;
		font-size: 0.8rem;
		letter-spacing: 0.1em;
	}

	.btn-submit {
		width: 100%;
		padding: 1.5rem;
		background: var(--text-primary);
		color: var(--bg-dark);
		border: none;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.9rem;
		cursor: pointer;
		transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
		margin-top: 2rem;
	}

	.btn-submit:hover {
		letter-spacing: 0.3em;
		background: var(--accent-cyan);
	}

	.form-messages {
		margin-top: 2rem;
	}

	.form-message {
		display: none;
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: 0.05em;
	}

	.success {
		color: var(--accent-cyan);
	}
	.error {
		color: #ff4d4d;
	}

	@media (max-width: 768px) {
		.form-grid {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	gsap.registerPlugin(ScrollTrigger);

	const form = document.getElementById("contactForm") as HTMLFormElement;
	const submitBtn = form?.querySelector(".btn-submit") as HTMLButtonElement;
	const successMsg = form?.querySelector(".success") as HTMLElement;
	const errorMsg = form?.querySelector(".error") as HTMLElement;

	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			submitBtn.disabled = true;
			const formData = new FormData(form);

			try {
				const response = await fetch(
					"https://api.web3forms.com/submit",
					{
						method: "POST",
						body: formData,
					},
				);
				const data = await response.json();
				if (data.success) {
					successMsg.style.display = "block";
					form.reset();
				} else {
					errorMsg.style.display = "block";
				}
			} catch (error) {
				errorMsg.style.display = "block";
			} finally {
				submitBtn.disabled = false;
			}
		});
	}

	// Scroll reveal - DISABLED for Pinned Container Compatibility
	// The pinned container messes up scroll triggers for inner elements.
	// We keep them static visible.

	/*
	gsap.from(".contact-form", {
		opacity: 0,
		y: 60,
		duration: 1.5,
		ease: "power3.out",
		scrollTrigger: {
			trigger: ".contact-section",
			start: "top 70%",
		},
	});

	gsap.from(".contact-header > *", {
		opacity: 0,
		y: 40,
		duration: 1.2,
		stagger: 0.2,
		ease: "power3.out",
		scrollTrigger: {
			trigger: ".contact-section",
			start: "top 75%",
		},
	});
	*/
</script>
