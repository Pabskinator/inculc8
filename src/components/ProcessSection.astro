---
const steps = [
	{
		num: "01",
		title: "Audit & Strategy",
		desc: "We analyze your current workflows and identify bottlenecks. A clear roadmap is designed to maximize ROI.",
	},
	{
		num: "02",
		title: "Build & Automate",
		desc: "Our engineers implement custom scripts, no-code integrations, and AI agents tailored to your needs.",
	},
	{
		num: "03",
		title: "Scale & optimize",
		desc: "We launch the system and continuously monitor performance, making data-driven adjustments for growth.",
	},
];
---

<section
	class="section-padding process-section"
	id="process"
>
	<div class="container">
		<div class="section-header">
			<span class="subtext">How It Works</span>
			<h2>Our Methodology</h2>
		</div>

		<div class="steps-container">
			{
				steps.map((step, index) => (
					<div class="step">
						<div class="step-line" />
						<div class="step-marker">{step.num}</div>
						<div class="step-content">
							<h3>{step.title}</h3>
							<p>{step.desc}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.process-section {
		padding: var(--section-spacing) 0;
		background: var(--bg-dark);
	}

	.section-header {
		margin-bottom: 5rem;
	}

	.subtext {
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent-cyan);
		display: block;
		margin-bottom: 1rem;
	}

	.steps-container {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 4rem;
		position: relative;
	}

	.step {
		position: relative;
		padding-top: 3rem;
	}

	.step-line {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background: var(--glass-border);
	}

	.step-line::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--gradient-tech);
		transition: width 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
	}

	.step.active .step-line::after,
	.step:hover .step-line::after {
		width: 100%;
	}

	.step-marker {
		font-size: 5rem;
		font-weight: 800;
		color: rgba(0, 240, 255, 0.25);
		margin-bottom: 1.5rem;
		transition: all 0.4s ease;
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.step.active .step-marker,
	.step:hover .step-marker {
		background: var(--gradient-tech);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		text-shadow: 0 0 40px var(--accent-cyan-glow);
		opacity: 0.9;
		transform: scale(1.05);
	}

	h3 {
		margin-bottom: 1rem;
		font-size: 1.5rem;
	}

	p {
		color: var(--text-muted);
	}
</style>
