<section
	class="process-section snap-section"
	id="process"
>
	<div class="container process-grid">
		<div class="process-content">
			<div class="badge-wrapper">
				<span class="badge">Our Journey</span>
			</div>

			<h2 class="section-title">
				The Path to <span class="text-gradient italics">Clarity.</span>
			</h2>

			<div class="steps-list">
				<div class="step-item">
					<div class="step-num">I</div>
					<div class="step-body">
						<h3>Strategic Audit</h3>
						<p>
							We deconstruct your current logic to find the
							fractures in your funnel.
						</p>
					</div>
				</div>
				<div class="step-item">
					<div class="step-num">II</div>
					<div class="step-body">
						<h3>System Assembly</h3>
						<p>
							Engineering the automated nerves that connect your
							business endpoints.
						</p>
					</div>
				</div>
				<div class="step-item">
					<div class="step-num">III</div>
					<div class="step-body">
						<h3>Recursive Scale</h3>
						<p>
							Continuous refinement of the system for exponential,
							logic-driven growth.
						</p>
					</div>
				</div>
			</div>
		</div>

		<div class="process-visual">
			<!-- Space reserved for the 3D model (right side in this act) -->
		</div>
	</div>
</section>

<style>
	.process-section {
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: var(--section-spacing) 0;
		position: relative;
	}

	.process-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	@media (max-width: 992px) {
		.process-grid {
			grid-template-columns: 1fr;
		}
		.process-visual {
			display: none;
		}
	}

	.italics {
		font-style: italic;
	}

	.steps-list {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		margin-top: 4rem;
	}

	.step-item {
		display: flex;
		gap: 2.5rem;
		transition: all 0.5s ease;
	}

	.step-item:hover {
		transform: translateX(10px);
	}

	.step-num {
		font-family: var(--font-heading);
		font-size: 1.5rem;
		color: var(--accent-cyan);
		opacity: 0.6;
		min-width: 40px;
	}

	.step-body h3 {
		font-size: 1.5rem;
		margin-bottom: 0.75rem;
		color: var(--text-primary);
		font-weight: 500;
	}

	.step-body p {
		font-size: 1rem;
		color: var(--text-secondary);
		line-height: 1.7;
		font-weight: 300;
		max-width: 450px;
	}
</style>

<script>
	import gsap from "gsap";
	// Event-Driven Animation for Index 3 (Process)
	window.addEventListener("sectionChange", ((e: CustomEvent) => {
		const { index, isActive } = e.detail;

		if (index === 3 && isActive) {
			// Enter
			gsap.to(".step-item", {
				autoAlpha: 1,
				x: 0,
				duration: 1.2,
				stagger: 0.2,
				ease: "power2.out",
				overwrite: true,
				delay: 0.5, // Sync tuning
			});
			gsap.to(
				".process-content > .section-title, .process-content > .badge-wrapper",
				{
					autoAlpha: 1,
					y: 0,
					duration: 1.2,
					stagger: 0.15,
					ease: "power2.out",
					overwrite: true,
					delay: 0.5, // Sync tuning
				},
			);
		} else if (index !== 3 || !isActive) {
			// Exit
			gsap.to(".step-item", {
				autoAlpha: 0,
				x: -30,
				duration: 0.4,
				overwrite: true,
			});
			gsap.to(
				".process-content > .section-title, .process-content > .badge-wrapper",
				{ autoAlpha: 0, y: 30, duration: 0.4, overwrite: true },
			);
		}
	}) as EventListener);
</script>
