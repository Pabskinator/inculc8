<div id="loading-screen">
	<div class="loader-content">
		<div class="tech-icon">
			<div class="circle outer"></div>
			<div class="circle middle"></div>
			<div class="circle inner"></div>
			<div class="core"></div>
		</div>
		<div class="percentage">0%</div>
		<div class="loading-text">SYSTEM PROCESSING...</div>
	</div>
</div>

<script>
	import { gsap } from "gsap";

	// Check if this is the first page load in this session
	const hasLoadedBefore = sessionStorage.getItem("hasLoadedBefore");
	const loadingScreen = document.getElementById("loading-screen");

	if (hasLoadedBefore) {
		// Not first load - hide immediately
		if (loadingScreen) {
			loadingScreen.style.display = "none";
			document.body.style.overflow = "auto";
		}
	} else {
		// First load - show loading animation
		sessionStorage.setItem("hasLoadedBefore", "true");

		window.addEventListener("load", () => {
			const tl = gsap.timeline();
			const percentage = document.querySelector(".percentage");

			// Counter Animation object
			let counter = { val: 0 };

			// Animation
			tl.to(counter, {
				val: 100,
				duration: 2.5,
				ease: "power2.inOut",
				onUpdate: () => {
					if (percentage)
						percentage.textContent = `${Math.round(counter.val)}%`;
				},
			}).to("#loading-screen", {
				yPercent: -100,
				duration: 1.2,
				ease: "power4.inOut",
				delay: 0.5,
				onComplete: () => {
					document.body.style.overflow = "auto";
				},
			});
		});
	}
</script>

<style>
	#loading-screen {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		background: #040712;
		z-index: 9999;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}

	.loader-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
	}

	.tech-icon {
		position: relative;
		width: 150px;
		height: 150px;
	}

	.circle {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		border: 2px solid transparent;
		border-radius: 50%;
	}

	.outer {
		width: 150px;
		height: 150px;
		border-top-color: var(--accent-cyan);
		border-bottom-color: var(--accent-cyan);
		animation: spin 3s linear infinite;
	}

	.middle {
		width: 100px;
		height: 100px;
		border-left-color: var(--accent-violet);
		border-right-color: var(--accent-violet);
		animation: spin-reverse 2s linear infinite;
	}

	.inner {
		width: 50px;
		height: 50px;
		border-top-color: var(--accent-cyan);
		animation: spin 1s linear infinite;
	}

	.core {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 12px;
		height: 12px;
		background: var(--accent-cyan);
		border-radius: 50%;
		box-shadow: 0 0 20px var(--accent-cyan);
		animation: pulse 1.5s ease-in-out infinite;
	}

	@keyframes spin {
		from {
			transform: translate(-50%, -50%) rotate(0deg);
		}
		to {
			transform: translate(-50%, -50%) rotate(360deg);
		}
	}

	@keyframes spin-reverse {
		from {
			transform: translate(-50%, -50%) rotate(360deg);
		}
		to {
			transform: translate(-50%, -50%) rotate(0deg);
		}
	}

	@keyframes pulse {
		0%,
		100% {
			transform: translate(-50%, -50%) scale(1);
			opacity: 1;
		}
		50% {
			transform: translate(-50%, -50%) scale(1.8);
			opacity: 0.5;
		}
	}

	.percentage {
		font-family: "Outfit", sans-serif;
		font-size: 4rem;
		font-weight: 800;
		color: var(--accent-cyan);
		text-shadow: 0 0 20px var(--accent-cyan-glow);
		letter-spacing: -0.05em;
	}

	.loading-text {
		color: var(--text-muted);
		font-family: inherit;
		letter-spacing: 0.5em;
		text-transform: uppercase;
		font-size: 0.75rem;
		font-weight: 500;
	}
</style>
