<div id="loading-screen">
	<div class="grain-overlay"></div>
	<div class="loader-content">
		<div class="brand-reveal">
			<span class="brand">INCULC8.</span>
		</div>
		<div class="progress-wrap">
			<div class="percentage-container">
				<span class="percentage">00</span>
			</div>
			<div class="progress-bar-wrap">
				<div class="progress-bar">
					<div class="progress-fill"></div>
				</div>
			</div>
		</div>
		<div class="loading-status">
			<span class="status-text">Synchronizing Systems</span>
		</div>
	</div>
</div>

<script>
	import { gsap } from "gsap";

	const hasLoadedBefore = sessionStorage.getItem("hasLoadedBefore");
	const loadingScreen = document.getElementById("loading-screen");

	if (hasLoadedBefore && loadingScreen) {
		loadingScreen.style.display = "none";
		document.body.style.overflow = "auto";
	} else {
		// sessionStorage.setItem("hasLoadedBefore", "true"); // Uncomment for production

		window.addEventListener("load", () => {
			const tl = gsap.timeline();
			const percentage = document.querySelector(".percentage");
			const fill = document.querySelector(".progress-fill");
			let counter = { val: 0 };

			// Initial state
			gsap.set(".brand", { y: 100, opacity: 0 });
			gsap.set(".loading-status", { opacity: 0 });

			tl.to(".brand", {
				y: 0,
				opacity: 1,
				duration: 1.5,
				ease: "power4.out",
				delay: 0.2,
			})
				.to(
					counter,
					{
						val: 100,
						duration: 3,
						ease: "expo.inOut",
						onUpdate: () => {
							if (percentage) {
								let v = Math.round(counter.val);
								percentage.textContent =
									v < 10 ? `0${v}` : `${v}`;
							}
							if (fill) {
								(fill as HTMLElement).style.width =
									`${counter.val}%`;
							}
						},
					},
					"-=0.5",
				)
				.to(
					".loading-status",
					{
						opacity: 0.5,
						duration: 1,
						ease: "power2.out",
					},
					"-=2",
				)
				.to("#loading-screen", {
					clipPath: "inset(0 0 100% 0)",
					duration: 1.5,
					ease: "expo.inOut",
					delay: 0.3,
					onComplete: () => {
						if (loadingScreen) loadingScreen.style.display = "none";
						document.body.style.overflow = "auto";
					},
				});
		});
	}
</script>

<style>
