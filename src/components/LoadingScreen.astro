		flex-direction: column;
		align-items: center;
		gap: 3rem;
		text-align: center;
		width: 100%;
		max-width: 400px;
	}

	.brand-reveal {
		overflow: hidden;
		padding: 0.5rem 0;
	}

	.brand {
		display: block;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: 0.4em;
		color: var(--text-primary);
		text-transform: uppercase;
	}

	.progress-wrap {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.percentage-container {
		height: 5rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.percentage {
		font-family: var(--font-heading);
		font-size: 5rem;
		font-weight: 300;
		color: var(--text-primary);
		font-style: italic;
		background: var(--gradient-premium);
