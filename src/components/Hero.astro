---

---

<header
	id="intro"
	class="hero snap-section"
>
	<div class="container hero-container">
		<div class="hero-content">
			<div
				class="badge-wrapper"
				data-scroll
				data-scroll-speed="1"
			>
				<span class="badge">Innovation Pioneer</span>
			</div>

			<h1 class="hero-title">
				<span class="line">Redefining the</span>
				<span class="line text-gradient">Digital Frontier</span>
				<span class="line">thru AI & Logic.</span>
			</h1>

			<p class="hero-subtitle">
				Inculc8 Solutions crafts high-conversion funnel systems and
				intelligent automation workflows for the modern enterprise.
			</p>

			<div class="hero-actions">
				<a
					href="#consultation"
					class="btn btn-primary"
				>
					<span>Commence Journey</span>
					<div class="btn-glow"></div>
				</a>
				<a
					href="#explore"
					class="btn btn-secondary"
				>
					<span>Our Methodology</span>
				</a>
			</div>
		</div>

		<!-- Decorative elements for depth -->
		<div class="hero-decor decor-1"></div>
		<div class="hero-decor decor-2"></div>
	</div>
</header>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: 0; /* Let flex center it */
		overflow: hidden;
	}

	.hero-container {
		position: relative;
		z-index: 10;
	}

	.hero-content {
		max-width: 800px;
		width: 100%;
		position: relative;
	}

	.hero-title {
		margin-bottom: 2.5rem;
		display: flex;
		flex-direction: column;
	}

	.hero-title .line {
		display: block;
		overflow: hidden;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		max-width: 600px;
		margin-bottom: 4rem;
		color: var(--text-primary-muted);
		font-weight: 300;
		line-height: 1.8;
	}

	.hero-actions {
		display: flex;
		gap: 2rem;
		align-items: center;
	}

	.btn {
		position: relative;
		padding: 1.25rem 3rem;
		border-radius: 0;
		font-weight: 600;
		font-size: 0.9rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		overflow: hidden;
		transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
	}

	.btn-primary {
		background: var(--text-primary);
		color: var(--bg-dark);
		border: 1px solid var(--text-primary);
	}

	.btn-primary:hover {
		background: transparent;
		color: var(--text-primary);
	}

	.btn-secondary {
		background: transparent;
		color: var(--text-primary);
		border: 1px solid rgba(255, 255, 255, 0.2);
	}

	.btn-secondary:hover {
		border-color: var(--text-primary);
		background: rgba(255, 255, 255, 0.05);
	}

	/* Decorative Orbs/Glows */
	.hero-decor {
		position: absolute;
		width: 40vw;
		height: 40vw;
		border-radius: 50%;
		filter: blur(120px);
		z-index: -1;
		opacity: 0.15;
		pointer-events: none;
	}

	.decor-1 {
		top: -10%;
		right: -10%;
		background: var(--accent-cyan);
	}

	.decor-2 {
		bottom: -20%;
		left: -10%;
		background: var(--accent-violet);
	}

	@media (max-width: 768px) {
		.hero-actions {
			flex-direction: column;
			align-items: flex-start;
		}

		.btn {
			width: 100%;
		}
	}
</style>

<script>
	import gsap from "gsap";

	// Text Reveal Animation
	// Event-Driven Animation for Index 0 (Hero)
	window.addEventListener("sectionChange", ((e: CustomEvent) => {
		const { index, isActive } = e.detail;

		if (index === 0 && isActive) {
			// Enter
			gsap.to(".hero-title .line", {
				y: 0,
				opacity: 1,
				duration: 1.2,
				stagger: 0.2,
				ease: "power3.out",
				delay: 0.2,
				overwrite: true,
			});
			gsap.to(".hero-subtitle, .hero-actions, .badge-wrapper", {
				y: 0,
				opacity: 1,
				duration: 1.2,
				stagger: 0.1,
				ease: "power3.out",
				delay: 0.4,
				overwrite: true,
			});
		} else {
			// Exit / Reset
			gsap.to(".hero-title .line", {
				y: 100,
				opacity: 0,
				duration: 0.5,
				overwrite: true,
			});
			gsap.to(".hero-subtitle, .hero-actions, .badge-wrapper", {
				y: 30,
				opacity: 0,
				duration: 0.5,
				overwrite: true,
			});
		}
	}) as EventListener);
</script>
