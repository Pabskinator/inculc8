---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer-inner">
		<p class="copyright">
			&copy; {currentYear} Inculc8. All rights reserved.
		</p>

		<div class="footer-links">
			<a
				href="mailto:hello@inculc8.com"
				class="link-item"
				>hello@inculc8.com</a
			>
			<span class="separator">/</span>
			<a
				href="#"
				class="link-item"
				>LinkedIn</a
			>
			<span class="separator">/</span>
			<a
				href="#"
				class="link-item"
				>Twitter</a
			>
		</div>
	</div>
</footer>

<style>
	.footer {
		width: 100%;
		border-top: 1px solid var(--glass-border);
		background: var(--glass-bg); /* Responsive theme color */
		backdrop-filter: blur(10px);
		padding: 0.35rem 5%; /* Ultra thin padding */
		margin-top: auto;
		z-index: 10;
		position: relative;
	}

	.footer-inner {
		max-width: 1800px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: nowrap;
		gap: 1rem;
		height: 100%;
	}

	.copyright {
		font-size: 0.7rem;
		color: var(--text-muted);
		margin: 0;
		font-family: var(--font-body);
		line-height: 1;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	.link-item {
		font-size: 0.7rem;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.3s ease;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		line-height: 1;
	}

	.link-item:hover {
		color: var(--accent-cyan);
	}

	.separator {
		color: var(--glass-border);
		font-size: 0.7rem;
		line-height: 1;
	}

	@media (max-width: 768px) {
		.footer-inner {
			flex-direction: column;
			gap: 0.5rem;
			padding: 0.25rem 0;
		}

		.footer {
			padding: 0.5rem 5%;
			height: auto;
		}
	}
</style>
