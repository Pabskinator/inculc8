<div id="canvas-container"></div>

<script>
	import * as THREE from "three";
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const container = document.getElementById("canvas-container");

	if (container) {
		container.innerHTML = "";

		const scene = new THREE.Scene();
		scene.fog = new THREE.FogExp2(0x040712, 0.04);

		// --- GRADIENT BACKGROUND PLANE ---
		const bgCanvas = document.createElement("canvas");
		bgCanvas.width = 512;
		bgCanvas.height = 512;
		const bgCtx = bgCanvas.getContext("2d");

		if (bgCtx) {
			// Create radial gradient (Midnight -> Cyan/Violet)
			const gradient = bgCtx.createRadialGradient(
				256,
				256,
				0,
				256,
				256,
				256,
			);
			gradient.addColorStop(0, "rgba(0, 240, 255, 0.08)"); // Cyan center
			gradient.addColorStop(0.5, "rgba(191, 148, 255, 0.05)"); // Violet mid
			gradient.addColorStop(1, "rgba(4, 7, 18, 0)"); // Midnight edge

			bgCtx.fillStyle = gradient;
			bgCtx.fillRect(0, 0, 512, 512);
		}

		const bgTexture = new THREE.CanvasTexture(bgCanvas);
		const bgPlane = new THREE.Mesh(
			new THREE.PlaneGeometry(50, 50),
			new THREE.MeshBasicMaterial({
				map: bgTexture,
				transparent: true,
				opacity: 0.6,
			}),
		);
		bgPlane.position.z = -15;
		scene.add(bgPlane);

		const camera = new THREE.PerspectiveCamera(
			75,
			window.innerWidth / window.innerHeight,
			0.1,
			1000,
		);
		camera.position.set(-4, 0, 8); // Shifted left (x=-4) to balance with right text

		const renderer = new THREE.WebGLRenderer({
			alpha: true,
			antialias: true,
		});
		renderer.setSize(window.innerWidth, window.innerHeight);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		container.appendChild(renderer.domElement);

		// --- COLORS ---
		// --- COLORS ---
		let colors = {
			cyan: 0x00f0ff,
			violet: 0xbf94ff,
			dark: 0x040712,
		};

		// Theme Handling
		const updateThemeColors = (theme: string) => {
			if (theme === "light") {
				colors.dark = 0xf8f9fa; // Very light gray/white-ish
				colors.cyan = 0x007794; // Deep Cyan
				colors.violet = 0x6a11cb; // Deep Violet

				// Update Fog
				scene.fog = new THREE.FogExp2(colors.dark, 0.05);

				// Update Bg Plane Opacity (lighter)
				bgPlane.material.opacity = 0.2;
			} else {
				colors.dark = 0x040712; // Dark Bg
				colors.cyan = 0x00f0ff;
				colors.violet = 0xbf94ff;

				scene.fog = new THREE.FogExp2(colors.dark, 0.04);
				bgPlane.material.opacity = 0.6;
			}
		};

		// Initialize based on current state
		if (document.documentElement.classList.contains("light-mode")) {
			updateThemeColors("light");
		}

		// Listen for changes
		window.addEventListener("theme-change", (e: any) => {
			updateThemeColors(e.detail.theme);
		});

		// --- 3D PROCESS FLOW SYSTEM ---
		const flowGroup = new THREE.Group();
		scene.add(flowGroup);

		// 1. MODULAR BLOCKS (Process Steps)
		const blockGeo = new THREE.BoxGeometry(1.5, 1.5, 1.5);
		const blocks: THREE.Group[] = [];

		function createBlock(x: number, y: number, z: number) {
			const group = new THREE.Group();
			group.position.set(x, y, z);

			// Wireframe box
			const wireframe = new THREE.LineSegments(
				new THREE.EdgesGeometry(blockGeo),
				new THREE.LineBasicMaterial({
					color: colors.violet,
					transparent: true,
					opacity: 0.4,
				}),
			);
			group.add(wireframe);

			// Inner glowing core
			const core = new THREE.Mesh(
				new THREE.BoxGeometry(0.5, 0.5, 0.5),
				new THREE.MeshBasicMaterial({
					color: colors.cyan,
					transparent: true,
					opacity: 0.15,
				}),
			);
			group.add(core);

			flowGroup.add(group);
			blocks.push(group);
			return group;
		}

		// Create process steps with varied vertical positions (Input → Process → Process 2 → Output)
		const step1 = createBlock(-4, 2, 0); // Input (high)
		const step2 = createBlock(-1, -1, -5); // Processing 1 (low)
		const step3 = createBlock(2, 1.5, -3); // Processing 2 (high)
		const step4 = createBlock(5, -0.5, 0); // Output (mid)

		// 2. DATA STREAMS (Particles flowing through process)
		const particleCount = 200;
		const particleGeometry = new THREE.BufferGeometry();
		const posArray = new Float32Array(particleCount * 3);
		const colorArray = new Float32Array(particleCount * 3);

		// Define flow paths between blocks
		const paths = [
			new THREE.QuadraticBezierCurve3(
				step1.position,
				new THREE.Vector3(-2.5, 1, -2.5),
				step2.position,
			),
			new THREE.QuadraticBezierCurve3(
				step2.position,
				new THREE.Vector3(0.5, -0.5, -4),
				step3.position,
			),
			new THREE.QuadraticBezierCurve3(
				step3.position,
				new THREE.Vector3(3.5, -1.5, -1.5),
				step4.position,
			),
		];

		// Particle data for animation
		const particleData: any[] = [];

		for (let i = 0; i < particleCount; i++) {
			const pathIndex = Math.floor(Math.random() * paths.length);
			const progress = Math.random();

			// Add random offset for particle spread (slimmer stream)
			const offsetX = (Math.random() - 0.5) * 0.8;
			const offsetY = (Math.random() - 0.5) * 0.8;
			const offsetZ = (Math.random() - 0.5) * 0.8;

			particleData.push({
				pathIndex,
				progress,
				speed: 0.003 + Math.random() * 0.002,
				offsetX,
				offsetY,
				offsetZ,
			});

			const point = paths[pathIndex].getPoint(progress);
			posArray[i * 3] = point.x + offsetX;
			posArray[i * 3 + 1] = point.y + offsetY;
			posArray[i * 3 + 2] = point.z + offsetZ;

			// Color transformation: Cyan → Violet as they flow
			const startColor = colors.cyan;
			const endColor = colors.violet;

			const color = new THREE.Color()
				.setHex(startColor)
				.lerp(new THREE.Color(endColor), progress);
			colorArray[i * 3] = color.r;
			colorArray[i * 3 + 1] = color.g;
			colorArray[i * 3 + 2] = color.b;
		}

		particleGeometry.setAttribute(
			"position",
			new THREE.BufferAttribute(posArray, 3),
		);
		particleGeometry.setAttribute(
			"color",
			new THREE.BufferAttribute(colorArray, 3),
		);

		const particleMaterial = new THREE.PointsMaterial({
			size: 0.08,
			vertexColors: true,
			transparent: true,
			opacity: 0.8,
			sizeAttenuation: true,
			blending: THREE.AdditiveBlending,
		});

		const particleSystem = new THREE.Points(
			particleGeometry,
			particleMaterial,
		);
		scene.add(particleSystem);

		// Flow lines removed - particles show the path clearly without static lines

		// --- AMBIENT FLOATING PARTICLES ---
		const ambientCount = 80;
		const ambientGeo = new THREE.BufferGeometry();
		const ambientPos = new Float32Array(ambientCount * 3);
		const ambientColors = new Float32Array(ambientCount * 3);
		const ambientSizes = new Float32Array(ambientCount);

		for (let i = 0; i < ambientCount; i++) {
			ambientPos[i * 3] = (Math.random() - 0.5) * 30;
			ambientPos[i * 3 + 1] = (Math.random() - 0.5) * 30;
			ambientPos[i * 3 + 2] = (Math.random() - 0.5) * 20;

			const color = new THREE.Color(
				Math.random() > 0.5 ? colors.cyan : colors.violet,
			);
			ambientColors[i * 3] = color.r;
			ambientColors[i * 3 + 1] = color.g;
			ambientColors[i * 3 + 2] = color.b;

			ambientSizes[i] = Math.random() * 1.5;
		}

		ambientGeo.setAttribute(
			"position",
			new THREE.BufferAttribute(ambientPos, 3),
		);
		ambientGeo.setAttribute(
			"color",
			new THREE.BufferAttribute(ambientColors, 3),
		);
		ambientGeo.setAttribute(
			"size",
			new THREE.BufferAttribute(ambientSizes, 1),
		);

		const ambientMat = new THREE.PointsMaterial({
			size: 0.04,
			vertexColors: true,
			transparent: true,
			opacity: 0.25,
			sizeAttenuation: true,
		});

		const ambientParticles = new THREE.Points(ambientGeo, ambientMat);
		scene.add(ambientParticles);

		// --- SUBTLE NETWORK CONNECTIONS ---
		const networkLines: THREE.Line[] = [];
		for (let i = 0; i < 8; i++) {
			const points = [
				new THREE.Vector3(
					(Math.random() - 0.5) * 25,
					(Math.random() - 0.5) * 25,
					(Math.random() - 0.5) * 15,
				),
				new THREE.Vector3(
					(Math.random() - 0.5) * 25,
					(Math.random() - 0.5) * 25,
					(Math.random() - 0.5) * 15,
				),
			];
			const lineGeo = new THREE.BufferGeometry().setFromPoints(points);
			const lineMat = new THREE.LineBasicMaterial({
				color: i % 2 === 0 ? colors.cyan : colors.violet,
				transparent: true,
				opacity: 0.08,
			});
			const line = new THREE.Line(lineGeo, lineMat);
			scene.add(line);
			networkLines.push(line);
		}

		// --- SCROLL ANIMATIONS ---
		gsap.to(flowGroup.rotation, {
			y: Math.PI * 0.5,
			scrollTrigger: {
				trigger: "body",
				start: "top top",
				end: "bottom bottom",
				scrub: 1,
			},
		});

		gsap.to(flowGroup.position, {
			z: -2,
			scrollTrigger: {
				trigger: "body",
				start: "top top",
				end: "30% 30%",
				scrub: 1,
			},
		});

		// --- ANIMATION LOOP ---
		function animate() {
			requestAnimationFrame(animate);

			// Rotate blocks subtly
			blocks.forEach((block, i) => {
				block.rotation.x += 0.002;
				block.rotation.y += 0.003;
			});

			// Update paths based on current block world positions
			const worldPos1 = new THREE.Vector3();
			const worldPos2 = new THREE.Vector3();
			const worldPos3 = new THREE.Vector3();
			const worldPos4 = new THREE.Vector3();

			step1.getWorldPosition(worldPos1);
			step2.getWorldPosition(worldPos2);
			step3.getWorldPosition(worldPos3);
			step4.getWorldPosition(worldPos4);

			// Recreate paths with current positions
			paths[0] = new THREE.QuadraticBezierCurve3(
				worldPos1,
				new THREE.Vector3(
					(worldPos1.x + worldPos2.x) / 2,
					(worldPos1.y + worldPos2.y) / 2,
					(worldPos1.z + worldPos2.z) / 2 - 1,
				),
				worldPos2,
			);
			paths[1] = new THREE.QuadraticBezierCurve3(
				worldPos2,
				new THREE.Vector3(
					(worldPos2.x + worldPos3.x) / 2,
					(worldPos2.y + worldPos3.y) / 2,
					(worldPos2.z + worldPos3.z) / 2 - 1,
				),
				worldPos3,
			);
			paths[2] = new THREE.QuadraticBezierCurve3(
				worldPos3,
				new THREE.Vector3(
					(worldPos3.x + worldPos4.x) / 2,
					(worldPos3.y + worldPos4.y) / 2,
					(worldPos3.z + worldPos4.z) / 2 - 1,
				),
				worldPos4,
			);

			// Animate particles along updated paths
			const positions = particleSystem.geometry.attributes.position;
			const colorsAttr = particleSystem.geometry.attributes.color;

			for (let i = 0; i < particleCount; i++) {
				const data = particleData[i];
				data.progress += data.speed;

				// Loop back to start
				if (data.progress > 1) {
					data.progress = 0;
				}

				// Get position on updated path
				const point = paths[data.pathIndex].getPoint(data.progress);
				positions.array[i * 3] = point.x + data.offsetX;
				positions.array[i * 3 + 1] = point.y + data.offsetY;
				positions.array[i * 3 + 2] = point.z + data.offsetZ;

				// Color transformation: Cycle between Cyan and Violet
				const startColor = colors.cyan;
				const endColor = colors.violet;

				const color = new THREE.Color()
					.setHex(startColor)
					.lerp(new THREE.Color(endColor), data.progress);
				colorsAttr.array[i * 3] = color.r;
				colorsAttr.array[i * 3 + 1] = color.g;
				colorsAttr.array[i * 3 + 2] = color.b;
			}

			positions.needsUpdate = true;
			colorsAttr.needsUpdate = true;

			// Drift ambient particles
			const ambientPosAttr =
				ambientParticles.geometry.attributes.position;
			for (let i = 0; i < ambientCount; i++) {
				ambientPosAttr.array[i * 3 + 1] +=
					Math.sin(Date.now() * 0.0005 + i) * 0.008;
				ambientPosAttr.array[i * 3] +=
					Math.cos(Date.now() * 0.0005 + i) * 0.005;

				// Wrap around
				if (ambientPosAttr.array[i * 3 + 1] > 15)
					ambientPosAttr.array[i * 3 + 1] = -15;
				if (ambientPosAttr.array[i * 3] > 15)
					ambientPosAttr.array[i * 3] = -15;
			}
			ambientPosAttr.needsUpdate = true;

			// Pulse network lines subtly
			networkLines.forEach((line, idx) => {
				(line.material as THREE.LineBasicMaterial).opacity =
					0.05 + Math.sin(Date.now() * 0.001 + idx) * 0.03;
			});

			renderer.render(scene, camera);
		}

		animate();

		// --- RESPONSIVE ---
		window.addEventListener("resize", () => {
			camera.aspect = window.innerWidth / window.innerHeight;
			camera.updateProjectionMatrix();
			renderer.setSize(window.innerWidth, window.innerHeight);
		});
	}
</script>

<style>
	#canvas-container {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		z-index: -1;
		pointer-events: none;
	}

	#canvas-container canvas {
		display: block;
	}
</style>
