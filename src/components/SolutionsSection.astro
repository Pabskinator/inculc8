---

---

<section
	class="section-padding solutions-section"
	id="services"
>
	<div class="container">
		<div class="header-split">
			<div>
				<span class="subtext">Our Solutions</span>
				<h2>Scalable Systems for Growth</h2>
			</div>
			<p class="description">
				We bridge the gap between complex technology and business
				results. From custom funnels to full-scale operational
				automation.
			</p>
		</div>

		<div class="cards-grid">
			<!-- Card 1 -->
			<div class="card">
				<div class="card-icon">⚡</div>
				<h3>Workflow Automation</h3>
				<p>
					Eliminate repetitive tasks. We connect your apps (CRM,
					Email, Slack) to create seamless data flows that save time
					and reduce error.
				</p>
				<a
					href="#"
					class="text-link"
					>Learn more &rarr;</a
				>
			</div>

			<!-- Card 2 -->
			<div class="card">
				<div class="card-icon">🎯</div>
				<h3>Funnel Development</h3>
				<p>
					High-converting landing pages and sales funnels designed to
					turn traffic into paying customers with optimized user
					journeys.
				</p>
				<a
					href="#"
					class="text-link"
					>View Examples &rarr;</a
				>
			</div>

			<!-- Card 3 -->
			<div class="card">
				<div class="card-icon">🤖</div>
				<h3>AI Integration</h3>
				<p>
					Leverage LLMs and AI agents to handle customer support,
					content generation, and data analysis automatically.
				</p>
				<a
					href="#"
					class="text-link"
					>Explore AI &rarr;</a
				>
			</div>
		</div>
	</div>
</section>

<style>
	.solutions-section {
		padding: var(--section-spacing) 0;
		background: transparent; /* Allow 3D background to show through */
	}

	.header-split {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 4rem;
		flex-wrap: wrap;
		gap: 2rem;
	}

	.subtext {
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent-cyan);
		display: block;
		margin-bottom: 1rem;
	}

	.description {
		max-width: 500px;
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2.5rem;
	}

	.card {
		background: var(--bg-card);
		padding: 3rem;
		border-radius: 12px;
		border: 2px solid var(--glass-border);
		transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
		position: relative;
		overflow: hidden;
		backdrop-filter: blur(10px);
	}

	.card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			135deg,
			rgba(0, 240, 255, 0.05) 0%,
			rgba(191, 148, 255, 0.05) 100%
		);
		opacity: 0;
		transition: opacity 0.5s ease;
		z-index: 0;
	}

	.card:hover {
		transform: translateY(-16px) scale(1.02);
		border-image: linear-gradient(
				135deg,
				var(--accent-cyan),
				var(--accent-violet)
			)
			1;
		box-shadow:
			0 30px 60px rgba(0, 240, 255, 0.2),
			0 15px 35px rgba(191, 148, 255, 0.15),
			inset 0 0 60px rgba(0, 240, 255, 0.03);
	}

	.card:hover::before {
		opacity: 1;
	}

	.card-icon {
		font-size: 2.5rem;
		margin-bottom: 2rem;
		display: block;
		position: relative;
		z-index: 2;
		transition: transform 0.3s ease;
	}

	.card:hover .card-icon {
		transform: scale(1.1) rotate(5deg);
	}

	h3 {
		margin-bottom: 1.25rem;
		font-size: 1.6rem;
		color: var(--text-primary);
		font-weight: 700;
		position: relative;
		z-index: 2;
		transition: all 0.3s ease;
	}

	.card:hover h3 {
		background: var(--gradient-tech);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.card p {
		color: var(--text-muted);
		margin-bottom: 2.5rem;
		line-height: 1.7;
		font-size: 1rem;
		position: relative;
		z-index: 2;
	}

	.text-link {
		color: var(--accent-cyan);
		font-weight: 600;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		position: relative;
		z-index: 2;
		transition: all 0.3s ease;
	}

	.text-link:hover {
		gap: 0.8rem;
		background: var(--gradient-tech);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
</style>
