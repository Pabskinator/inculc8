<section
	class="solutions-section snap-section"
	id="services"
>
	<div class="container">
		<div class="solutions-header">
			<div class="badge-wrapper">
				<span class="badge">Our Methodology</span>
			</div>

			<h2 class="section-title centered">
				Systems that <span class="text-gradient italics">Breathe</span>
				<br />
				and Evolve.
			</h2>
		</div>

		<div class="solutions-grid">
			<div class="solution-card">
				<div class="card-icon">01</div>
				<h3>Architectural Design</h3>
				<p>
					We don't just build; we architect. Custom funnel structures
					designed to guide users through a seamless, logical journey.
				</p>
			</div>

			<div class="solution-card">
				<div class="card-icon">02</div>
				<h3>Neural Automation</h3>
				<p>
					Connecting the dots between your CRM, AI agents, and
					operations to create a self-sustaining business ecosystem.
				</p>
			</div>

			<div class="solution-card">
				<div class="card-icon">03</div>
				<h3>Quantum Growth</h3>
				<p>
					Scaling with precision. Our data-driven funnels ensure that
					every click is a step towards a measurable business outcome.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.solutions-section {
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: 0;
		position: relative;
		text-align: center;
	}

	.solutions-header {
		margin-bottom: 6rem;
	}

	.italics {
		font-style: italic;
	}

	.solutions-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 3rem;
	}

	.solution-card {
		background: var(--glass-bg);
		backdrop-filter: blur(12px);
		padding: 4rem 3rem;
		border: 1px solid var(--glass-border);
		transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
		text-align: left;
		position: relative;
		overflow: hidden;
	}

	.solution-card::before {
		content: "";
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--gradient-premium);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.6s ease;
	}

	.solution-card:hover {
		background: var(--bg-accent);
		transform: translateY(-10px);
		border-color: var(--accent-cyan);
	}

	.solution-card:hover::before {
		transform: scaleX(1);
		transform-origin: left;
	}

	.card-icon {
		font-family: var(--font-heading);
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		color: var(--accent-cyan);
		margin-bottom: 2rem;
		display: block;
		opacity: 0.6;
	}

	h3 {
		font-size: 1.75rem;
		margin-bottom: 1.5rem;
		color: var(--text-primary);
		font-weight: 500;
	}

	.solution-card p {
		font-size: 1rem;
		color: var(--text-secondary);
		line-height: 1.8;
		font-weight: 300;
	}

	@media (max-width: 768px) {
		.solutions-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	// Event-Driven Animation for Index 2 (Solutions Section)
	window.addEventListener("sectionChange", ((e: CustomEvent) => {
		const { index, isActive } = e.detail;

		if (index === 2 && isActive) {
			// Cards stagger animation
			gsap.fromTo(
				".solution-card",
				{ autoAlpha: 0, y: 40 },
				{
					autoAlpha: 1,
					y: 0,
					duration: 1.2,
					stagger: 0.2,
					ease: "power2.out",
					overwrite: true,
					delay: 0.5, // Sync tuning
				},
			);
		} else if (index !== 2 || !isActive) {
			// Reset immediately when not active
			gsap.set(".solution-card", { autoAlpha: 0, y: 40 });
		}
	}) as EventListener);
</script>
