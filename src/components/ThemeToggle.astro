<div class="theme-switch-wrapper">
	<input
		type="checkbox"
		id="theme-checkbox"
		class="theme-checkbox"
	/>
	<label
		for="theme-checkbox"
		class="theme-label"
	>
		<div class="switch-handle">
			<div class="sun-moon">
				<div class="dots"></div>
			</div>
		</div>
		<div class="background-elements">
			<div class="stars">
				<span></span><span></span><span></span><span></span><span
				></span>
			</div>
			<div class="clouds">
				<div class="cloud cloud-1"></div>
				<div class="cloud cloud-2"></div>
				<div class="cloud cloud-3"></div>
			</div>
		</div>
	</label>
</div>

<style>
	.theme-switch-wrapper {
		display: flex;
		align-items: center;
	}

	.theme-checkbox {
		display: none;
	}

	.theme-label {
		position: relative;
		width: 70px;
		height: 32px;
		background: #2b3d52; /* Night background */
		border-radius: 50px;
		cursor: pointer;
		transition: background 0.5s ease;
		overflow: hidden;
		box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.3);
	}

	.switch-handle {
		position: absolute;
		top: 3px;
		left: 3px;
		width: 26px;
		height: 26px;
		background: #fdfdfd;
		border-radius: 50%;
		transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
	}

	.sun-moon {
		position: relative;
		width: 100%;
		height: 100%;
		background: #fdfdfd; /* Moon color */
		border-radius: 50%;
		transition: all 0.5s ease;
		box-shadow: inset -5px -2px 0 0 #d1d1d1;
	}

	/* Moon Craters */
	.dots {
		position: absolute;
		top: 5px;
		left: 5px;
		width: 4px;
		height: 4px;
		background: #d1d1d1;
		border-radius: 50%;
		opacity: 1;
		transition: opacity 0.3s;
	}
	.dots::before,
	.dots::after {
		content: "";
		position: absolute;
		background: #d1d1d1;
		border-radius: 50%;
	}
	.dots::before {
		top: 8px;
		left: 6px;
		width: 6px;
		height: 6px;
	}
	.dots::after {
		top: 12px;
		left: -2px;
		width: 3px;
		height: 3px;
	}

	/* Day Background */
	.theme-checkbox:checked + .theme-label,
	:global(.light-mode) .theme-label {
		background: #87ceeb; /* Sky blue */
	}

	/* Toggle Animation */
	.theme-checkbox:checked + .theme-label .switch-handle,
	:global(.light-mode) .theme-label .switch-handle {
		transform: translateX(38px);
	}

	.theme-checkbox:checked + .theme-label .sun-moon,
	:global(.light-mode) .theme-label .sun-moon {
		background: #f1c40f; /* Sun color */
		box-shadow: 0 0 10px rgba(241, 196, 15, 0.4);
	}

	.theme-checkbox:checked + .theme-label .dots,
	:global(.light-mode) .theme-label .dots {
		opacity: 0;
	}

	/* background-elements (Stars/Clouds) */
	.background-elements {
		position: absolute;
		width: 100%;
		height: 100%;
		top: 0;
		left: 0;
		pointer-events: none;
	}

	.stars span {
		position: absolute;
		background: #fff;
		border-radius: 50%;
		opacity: 0.8;
		transition:
			transform 0.5s ease,
			opacity 0.5s ease;
	}
	.stars span:nth-child(1) {
		top: 8px;
		left: 45px;
		width: 2px;
		height: 2px;
	}
	.stars span:nth-child(2) {
		top: 18px;
		left: 52px;
		width: 3px;
		height: 3px;
	}
	.stars span:nth-child(3) {
		top: 22px;
		left: 42px;
		width: 2px;
		height: 2px;
	}
	.stars span:nth-child(4) {
		top: 10px;
		left: 58px;
		width: 2px;
		height: 2px;
	}
	.stars span:nth-child(5) {
		top: 20px;
		left: 62px;
		width: 1px;
		height: 1px;
	}

	.theme-checkbox:checked + .theme-label .stars span,
	:global(.light-mode) .theme-label .stars span {
		transform: translateY(30px);
		opacity: 0;
	}

	.clouds {
		position: absolute;
		top: 35px;
		left: 10px;
		transition: transform 0.5s ease;
	}

	.cloud {
		position: absolute;
		background: #fff;
		border-radius: 10px;
		opacity: 0.9;
	}
	.cloud-1 {
		width: 15px;
		height: 5px;
		top: 0;
		left: 0;
	}
	.cloud-2 {
		width: 20px;
		height: 6px;
		top: -8px;
		left: 8px;
	}
	.cloud-3 {
		width: 12px;
		height: 4px;
		top: -4px;
		left: 22px;
	}

	.theme-checkbox:checked + .theme-label .clouds,
	:global(.light-mode) .theme-label .clouds {
		transform: translateY(-22px);
	}

	/* Dark mode is default */
	:global(.light-mode) .theme-label {
		/* Handled by :checked logic since we toggle class on html */
	}
</style>

<script>
	const themeCheckbox = document.getElementById(
		"theme-checkbox",
	) as HTMLInputElement;

	// Function to set theme
	const setTheme = (isLight: boolean) => {
		if (isLight) {
			document.documentElement.classList.add("light-mode");
			localStorage.setItem("theme", "light");
			if (themeCheckbox) themeCheckbox.checked = true;
		} else {
			document.documentElement.classList.remove("light-mode");
			localStorage.setItem("theme", "dark");
			if (themeCheckbox) themeCheckbox.checked = false;
		}

		window.dispatchEvent(
			new CustomEvent("theme-change", {
				detail: { theme: isLight ? "light" : "dark" },
			}),
		);
	};

	// Initialize
	const savedTheme = localStorage.getItem("theme");
	const savedThemeIsLight = savedTheme === "light";

	// Apply initial state
	setTheme(savedThemeIsLight);

	// Click Handler
	themeCheckbox?.addEventListener("change", () => {
		setTheme(themeCheckbox.checked);
	});
</script>
