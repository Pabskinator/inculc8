---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
	{ name: "Intro", href: "#intro", index: 0 },
	{ name: "Challenge", href: "#challenge", index: 1 },
	{ name: "Solutions", href: "#services", index: 2 },
	{ name: "Process", href: "#process", index: 3 },
	{ name: "Results", href: "#credibility", index: 4 },
];
---

<nav
	class="nav-wrapper"
	id="main-nav"
>
	<div class="nav-container">
		<!-- Logo -->
		<a
			href="/"
			class="logo-mark"
			>I8.</a
		>

		<!-- Navigation Links -->
		<div class="nav-links">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="nav-link"
						data-index={link.index}
					>
						{link.name}
					</a>
				))
			}
			<a
				href="#contact"
				class="nav-link contact-btn"
				data-index="5"
				>Contact Us</a
			>
		</div>

		<!-- Theme Toggle -->
		<div class="nav-actions">
			<ThemeToggle />
		</div>
	</div>
</nav>

<style>
	.nav-wrapper {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 1000;
		padding: 1.5rem 2rem;
		transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
		display: flex;
		justify-content: center;
	}

	/* Scrolled "Pill" State */
	.nav-wrapper.scrolled {
		padding: 0.75rem 2rem;
	}

	.nav-container {
		width: 100%;
		max-width: 1200px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
		padding: 0.5rem 1.5rem;
		border-radius: 100px;
		background: transparent;
		border: 1px solid transparent;
	}

	.nav-wrapper.scrolled .nav-container {
		background: rgba(10, 15, 30, 0.7);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		padding: 0.5rem 1.5rem;
	}

	:global(.light-mode) .nav-wrapper.scrolled .nav-container {
		background: rgba(255, 255, 255, 0.7);
		border-color: rgba(0, 0, 0, 0.05);
	}

	.logo-mark {
		font-family: var(--font-heading, sans-serif);
		font-weight: 800;
		color: var(--text-primary);
		text-decoration: none;
		font-size: 1.5rem;
		transition: all 0.3s;
		flex-shrink: 0;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.nav-link {
		color: var(--text-primary);
		text-decoration: none;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 500;
		opacity: 0.7;
		transition: all 0.3s;
		position: relative;
		padding: 0.5rem 0;
	}

	.nav-link:hover,
	.nav-link.active {
		opacity: 1;
		color: var(--accent-cyan);
	}

	.nav-link::after {
		content: "";
		position: absolute;
		bottom: 0;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--accent-cyan);
		transition: width 0.3s;
	}

	.nav-link:hover::after,
	.nav-link.active::after {
		width: 100%;
	}

	/* Contact Button Styling - Harmonized */
	.contact-btn {
		border: 1px solid var(--accent-cyan);
		color: var(--accent-cyan) !important;
		padding: 0.5rem 1.25rem !important;
		border-radius: 100px;
		opacity: 0.9 !important;
		font-weight: 600;
		margin-left: 1rem;
		transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
		background: rgba(47, 255, 220, 0.05);
	}

	.contact-btn:hover {
		background: var(--accent-cyan);
		color: var(--bg-dark) !important;
		opacity: 1 !important;
		transform: translateY(-1px);
		box-shadow: 0 4px 15px rgba(47, 255, 220, 0.3);
	}

	.contact-btn::after {
		display: none;
	}

	.contact-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(47, 255, 220, 0.5);
		filter: brightness(1.1);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-shrink: 0;
	}

	@media (max-width: 768px) {
		.nav-links {
			display: none; /* Mobile menu needed but starting with desktop */
		}
	}
</style>

<script>
	const nav = document.getElementById("main-nav");
	const navLinks = document.querySelectorAll(".nav-link");

	// Scroll Observer for sticky pill
	window.addEventListener("scroll", () => {
		if (window.scrollY > 50) {
			nav?.classList.add("scrolled");
		} else {
			nav?.classList.remove("scrolled");
		}
	});

	function setActiveLink(index: number) {
		navLinks.forEach((link) => link.classList.remove("active"));
		const targetLink = document.querySelector(
			`.nav-link[data-index="${index}"]`,
		);
		if (targetLink) {
			targetLink.classList.add("active");
		}
	}

	// Listen for section changes from SnapScroll
	window.addEventListener("sectionChange", (e: any) => {
		const idx = e.detail?.index;
		if (typeof idx === "number") {
			setActiveLink(idx);
		}
	});

	// Handle Click to Snap
	navLinks.forEach((link) => {
		link.addEventListener("click", (e) => {
			e.preventDefault();
			const indexStr = link.getAttribute("data-index");
			if (indexStr !== null) {
				const index = parseInt(indexStr, 10);
				window.dispatchEvent(
					new CustomEvent("request-snap-to", { detail: { index } }),
				);
			}
		});
	});

	// Handle Logo Click
	const logo = document.querySelector(".logo-mark");
	logo?.addEventListener("click", (e) => {
		e.preventDefault();
		window.dispatchEvent(
			new CustomEvent("request-snap-to", { detail: { index: 0 } }),
		);
	});
</script>
