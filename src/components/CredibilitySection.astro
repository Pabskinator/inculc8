<section
	id="credibility"
	class="credibility-section snap-section"
>
	<div class="container overflow-hidden">
		<div class="quote-wrapper">
			<span class="quote-mark">“</span>
			<blockquote>
				Inculc8 transformed our chaotic manual sales process into a
				streamlined machine. We doubled our conversion rate in three
				months through pure digital logic.
			</blockquote>
			<cite>— TechStart Innovations</cite>
		</div>

		<div class="metrics-row">
			<div class="metric-item">
				<span class="metric-val">3.5<span class="x">x</span></span>
				<span class="metric-label">ROI Average</span>
			</div>
			<div class="metric-item">
				<span class="metric-val">40<span class="plus">+</span></span>
				<span class="metric-label">Systems Built</span>
			</div>
			<div class="metric-item">
				<span class="metric-val">24/7</span>
				<span class="metric-label">Automated Uptime</span>
			</div>
		</div>
	</div>
</section>

<style>
	.credibility-section {
		padding: var(--section-spacing) 0;
		position: relative;
		text-align: center;
	}

	.quote-wrapper {
		max-width: 900px;
		margin: 0 auto 8rem;
		position: relative;
	}

	.quote-mark {
		font-family: var(--font-heading);
		font-size: 8rem;
		position: absolute;
		top: -4rem;
		left: 50%;
		transform: translateX(-50%);
		opacity: 0.1;
		color: var(--accent-cyan);
	}

	blockquote {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.3;
		color: var(--text-primary);
		margin-bottom: 2.5rem;
		font-weight: 400;
	}

	cite {
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--accent-cyan);
		font-style: normal;
		font-weight: 600;
	}

	.metrics-row {
		display: flex;
		justify-content: center;
		gap: 6rem;
		flex-wrap: wrap;
	}

	.metric-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.metric-val {
		font-family: var(--font-heading);
		font-size: 3rem;
		color: var(--text-primary);
		font-weight: 500;
	}

	.metric-val .x,
	.metric-val .plus {
		font-size: 1.5rem;
		color: var(--accent-cyan);
		margin-left: 2px;
	}

	.metric-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--text-muted);
		font-weight: 600;
	}

	@media (max-width: 768px) {
		.metrics-row {
			gap: 3rem;
		}
	}
</style>

<script>
	import gsap from "gsap";
	// Event-Driven Animation for Index 4 (Credibility)
	window.addEventListener("sectionChange", ((e: CustomEvent) => {
		const { index, isActive } = e.detail;

		if (index === 4 && isActive) {
			// Enter
			gsap.to(".quote-wrapper", {
				opacity: 1,
				scale: 1,
				y: 0,
				duration: 1.2,
				ease: "power3.out",
				overwrite: true,
				delay: 0.5, // Sync tuning
			});
			gsap.to(".metric-item", {
				opacity: 1,
				y: 0,
				stagger: 0.1,
				duration: 1.2,
				ease: "power2.out",
				overwrite: true,
				delay: 0.5, // Sync tuning
			});
		} else if (index !== 4 || !isActive) {
			// Exit
			gsap.to(".quote-wrapper", {
				opacity: 0,
				scale: 0.95,
				y: 20,
				duration: 0.4,
				overwrite: true,
			});
			gsap.to(".metric-item", {
				opacity: 0,
				y: 30,
				duration: 0.4,
				overwrite: true,
			});
		}
	}) as EventListener);
</script>
