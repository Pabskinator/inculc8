<script>
	// Shuffle text animation before revealing actual number
	function shuffleText(element, finalText, duration = 1000) {
		const chars = "0123456789$%+xh/";
		const steps = 20;
		const stepDuration = duration / steps;
		let currentStep = 0;

		const interval = setInterval(() => {
			if (currentStep >= steps) {
				element.textContent = finalText;
				clearInterval(interval);
				return;
			}

			// Generate random text
			let randomText = "";
			for (let i = 0; i < finalText.length; i++) {
				if (currentStep / steps > i / finalText.length) {
					randomText += finalText[i];
				} else {
					randomText +=
						chars[Math.floor(Math.random() * chars.length)];
				}
			}

			element.textContent = randomText;
			currentStep++;
		}, stepDuration);
	}

	// Count up animation for numbers
	function countUp(element, target, duration = 1500) {
		const isDecimal = target.includes(".");
		const hasX = target.includes("x");
		const hasPlus = target.includes("+");
		const hasDollar = target.includes("$");
		const hasPercent = target.includes("%");
		const hasSlash = target.includes("/");

		// Extract numeric value
		let numericValue = parseFloat(target.replace(/[^0-9.]/g, ""));

		if (isNaN(numericValue)) {
			// If not a number, use shuffle animation
			shuffleText(element, target, duration);
			return;
		}

		const startTime = Date.now();
		const animate = () => {
			const elapsed = Date.now() - startTime;
			const progress = Math.min(elapsed / duration, 1);

			// Easing function
			const easeOutQuart = 1 - Math.pow(1 - progress, 4);
			const current = numericValue * easeOutQuart;

			let displayValue = isDecimal
				? current.toFixed(1)
				: Math.floor(current);

			// Add suffixes
			if (hasX) displayValue += "x";
			if (hasPlus) displayValue += "+";
			if (hasDollar)
				displayValue = "$".repeat(target.split("$").length - 1);
			if (hasPercent) displayValue += "%";
			if (hasSlash) displayValue = target; // Special handling for 24/7

			element.textContent = displayValue;

			if (progress < 1) {
				requestAnimationFrame(animate);
			} else {
				element.textContent = target;
			}
		};

		animate();
	}

	// Initialize animations when elements come into view
	const observerOptions = {
		threshold: 0.5,
		rootMargin: "0px",
	};

	const animatedNumbers = new Set();

	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting && !animatedNumbers.has(entry.target)) {
				animatedNumbers.add(entry.target);
				const finalText = entry.target.getAttribute("data-number");
				const animationType =
					entry.target.getAttribute("data-animation") || "countup";

				// Small delay for stagger effect
				const delay = parseInt(
					entry.target.getAttribute("data-delay") || "0",
				);

				setTimeout(() => {
					if (animationType === "shuffle") {
						shuffleText(entry.target, finalText, 1200);
					} else {
						countUp(entry.target, finalText, 1500);
					}
				}, delay);
			}
		});
	}, observerOptions);

	// Observe all elements with data-number attribute
	document.addEventListener("DOMContentLoaded", () => {
		document.querySelectorAll("[data-number]").forEach((el) => {
			observer.observe(el);
		});
	});
</script>
