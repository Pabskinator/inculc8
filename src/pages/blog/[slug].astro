const { post } = Astro.props;

// Format date
const date = new Date(post.publishedDate);
const formattedDate = date.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title={`${post.title} | Inculc8 Blog`}>
	<Navigation />

	<main class="blog-post">
		<article class="post-container">
			<header class="post-header">
				<div class="container">
					<span class="category-badge">{post.category}</span>
					<h1 class="post-title">{post.title}</h1>
					<div class="post-meta">
						<span class="author">{post.author}</span>
						<span class="separator">•</span>
						<time datetime={post.publishedDate}
							>{formattedDate}</time
						>
					</div>
					<div class="post-tags">
						{post.tags.map((tag) => <span class="tag">{tag}</span>)}
					</div>
				</div>
			</header>

			<div class="post-image">
				<img
					src={post.image}
					alt={post.title}
				/>
			</div>

			<div class="post-content">
				<div class="container">
					<div
						class="content-wrapper"
						set:html={post.content}
					/>
				</div>
			</div>

			<footer class="post-footer">
				<div class="container">
					<a
						href="/blog"
						class="back-link"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line
								x1="19"
								y1="12"
								x2="5"
								y2="12"
							></line>
							<polyline points="12 19 5 12 12 5"></polyline>
						</svg>
						Back to Blog
					</a>
				</div>
			</footer>
		</article>
	</main>

	<Footer />
</Layout>

<style>
	.blog-post {
		padding-top: 80px;
		min-height: 100vh;
	}

	.post-header {
		padding: 4rem 0 2rem;
		text-align: center;
	}

	.category-badge {
		display: inline-block;
		background: var(--accent-cyan);
		color: var(--bg-dark);
		padding: 0.5rem 1rem;
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1.5rem;
	}

	.post-title {
		font-size: 3rem;
		font-weight: 800;
		margin-bottom: 1.5rem;
		line-height: 1.2;
		max-width: 900px;
		margin-left: auto;
		margin-right: auto;
	}

	.post-meta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		font-size: 1rem;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
	}

	.separator {
		opacity: 0.5;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	.tag {
		padding: 0.5rem 1rem;
		background: rgba(0, 240, 255, 0.1);
		border: 1px solid rgba(0, 240, 255, 0.2);
		border-radius: 16px;
		font-size: 0.875rem;
		color: var(--accent-cyan);
		font-weight: 600;
	}

	.post-image {
		max-width: 1200px;
		margin: 0 auto 4rem;
		border-radius: 16px;
		overflow: hidden;
	}

	.post-image img {
		width: 100%;
		height: auto;
		display: block;
	}

	.post-content {
		padding: 0 0 4rem;
	}

	.content-wrapper {
		max-width: 800px;
		margin: 0 auto;
		font-size: 1.125rem;
		line-height: 1.8;
		color: var(--text-secondary);
	}

	.content-wrapper :global(h1),
	.content-wrapper :global(h2),
	.content-wrapper :global(h3) {
		color: var(--text-primary);
		font-weight: 700;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		line-height: 1.3;
	}

	.content-wrapper :global(h1) {
		font-size: 2.5rem;
	}

	.content-wrapper :global(h2) {
		font-size: 2rem;
		background: var(--gradient-tech);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.content-wrapper :global(h3) {
		font-size: 1.5rem;
	}

	.content-wrapper :global(p) {
		margin-bottom: 1.5rem;
	}

	.content-wrapper :global(ul),
	.content-wrapper :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 2rem;
	}

	.content-wrapper :global(li) {
		margin-bottom: 0.75rem;
	}

	.content-wrapper :global(strong) {
		color: var(--text-primary);
		font-weight: 700;
	}

	.content-wrapper :global(a) {
		color: var(--accent-cyan);
		text-decoration: underline;
		transition: color 0.3s ease;
	}

	.content-wrapper :global(a:hover) {
		color: var(--accent-violet);
	}

	.post-footer {
		padding: 2rem 0 4rem;
		border-top: 1px solid var(--glass-border);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--accent-cyan);
		font-weight: 600;
		text-decoration: none;
		transition: gap 0.3s ease;
	}

	.back-link:hover {
		gap: 1rem;
	}

	@media (max-width: 768px) {
		.post-title {
			font-size: 2rem;
		}

		.content-wrapper {
			font-size: 1rem;
		}

		.content-wrapper :global(h1) {
			font-size: 2rem;
		}

		.content-wrapper :global(h2) {
			font-size: 1.5rem;
		}
	}
</style>
