import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/BlogCard.astro";
---

<Layout title="Blog | Inculc8 Solutions">
	<Navigation />

	<main class="blog-page">
		<section class="blog-header">
			<div class="container">
				<span class="subtext">Insights & Resources</span>
				<h1>Our <span class="text-gradient">Blog</span></h1>
				<p class="lead">
					Expert insights on AI automation, funnel optimization, and
					business growth strategies.
				</p>
			</div>
		</section>

		<section class="blog-grid section-padding">
			<div class="container">
				<div class="posts-grid">
					{mockPosts.map((post) => <BlogCard post={post} />)}
				</div>

				<!-- Pagination placeholder -->
				<div class="pagination">
					<button class="page-btn active">1</button>
					<button class="page-btn">2</button>
					<button class="page-btn">3</button>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.blog-page {
		padding-top: 80px;
		min-height: 100vh;
	}

	.blog-header {
		padding: 6rem 0 4rem;
		text-align: center;
		background: linear-gradient(
			180deg,
			rgba(0, 240, 255, 0.05) 0%,
			transparent 100%
		);
	}

	.subtext {
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent-cyan);
		display: block;
		margin-bottom: 1rem;
	}

	h1 {
		font-size: 3.5rem;
		font-weight: 800;
		margin-bottom: 1.5rem;
		letter-spacing: -0.02em;
	}

	.text-gradient {
		background: var(--gradient-tech);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.lead {
		font-size: 1.25rem;
		color: var(--text-secondary);
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.8;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: 2.5rem;
		margin-bottom: 4rem;
	}

	.pagination {
		display: flex;
		justify-content: center;
		gap: 1rem;
	}

	.page-btn {
		padding: 0.75rem 1.25rem;
		border-radius: 8px;
		border: 1px solid var(--glass-border);
		background: var(--bg-card);
		color: var(--text-primary);
		font-weight: 600;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.page-btn:hover,
	.page-btn.active {
		background: var(--accent-cyan);
		color: var(--bg-dark);
		border-color: var(--accent-cyan);
	}

	@media (max-width: 768px) {
		h1 {
			font-size: 2.5rem;
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
